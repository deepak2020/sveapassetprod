{
  "name": "ChallengeQuestion",
  "type": "object",
  "properties": {
    "q": {
      "type": "string",
      "description": "Swedish question"
    },
    "a": {
      "type": "string",
      "description": "Correct answer"
    },
    "choices": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "en": {
      "type": "string",
      "description": "English translation"
    },
    "category": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional free-form description"
    }
  },
  "required": [
    "q",
    "a",
    "choices",
    "en"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}