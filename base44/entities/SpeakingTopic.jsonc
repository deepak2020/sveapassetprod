{
  "name": "SpeakingTopic",
  "type": "object",
  "properties": {
    "title_sv": {
      "type": "string",
      "description": "Topic title in Swedish"
    },
    "title_en": {
      "type": "string",
      "description": "Topic title in English"
    },
    "description_en": {
      "type": "string",
      "description": "Short description of what the conversation is about"
    },
    "level": {
      "type": "string",
      "enum": [
        "A1",
        "A2",
        "B1",
        "B2",
        "C1"
      ],
      "description": "CEFR level"
    },
    "category": {
      "type": "string",
      "enum": [
        "survival",
        "service",
        "society",
        "work",
        "nuance",
        "meta",
        "seasonal",
        "emergency"
      ],
      "description": "Scenario category"
    },
    "opener_sv": {
      "type": "string",
      "description": "Svea's opening line in Swedish"
    },
    "opener_en": {
      "type": "string",
      "description": "English translation of Svea's opening line"
    },
    "suggested_vocab": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Handy Swedish words/phrases learners can use in this conversation"
    },
    "emoji": {
      "type": "string",
      "description": "Emoji icon for the topic card"
    },
    "order": {
      "type": "number",
      "description": "Display order"
    },
    "goal": {
      "type": "string",
      "description": "The concrete outcome the user is trying to achieve, e.g. 'Book an urgent dentist appointment for today or tomorrow'"
    },
    "success_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Short list of things the user must do/say to complete the mission"
    },
    "curveballs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Unexpected turns Svea can throw at the user (e.g. 'Asks for personnummer')"
    },
    "cultural_notes": {
      "type": "string",
      "description": "One short cultural or register tip for this scenario"
    },
    "key_vocabulary": {
      "type": "array",
      "description": "5\u20138 core words for this scenario, shown as flashcards before the conversation",
      "items": {
        "type": "object",
        "properties": {
          "swedish": {
            "type": "string"
          },
          "english": {
            "type": "string"
          },
          "example_sv": {
            "type": "string"
          },
          "example_en": {
            "type": "string"
          },
          "pronunciation_tip": {
            "type": "string"
          }
        },
        "required": [
          "swedish",
          "english"
        ]
      }
    },
    "key_phrases": {
      "type": "array",
      "description": "4\u20136 core phrases the user will likely need, shown before the conversation",
      "items": {
        "type": "object",
        "properties": {
          "situation_en": {
            "type": "string",
            "description": "When to use this phrase"
          },
          "phrase_sv": {
            "type": "string"
          },
          "phrase_en": {
            "type": "string"
          },
          "pronunciation_tip": {
            "type": "string"
          }
        },
        "required": [
          "phrase_sv",
          "phrase_en"
        ]
      }
    },
    "rehearsal_drills": {
      "type": "array",
      "description": "Short rehearsal exercises (gap-fill or quick-response) before the live conversation",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "gap_fill",
              "quick_response"
            ]
          },
          "prompt_sv": {
            "type": "string",
            "description": "For gap_fill: sentence with ___ blank. For quick_response: what Svea asks."
          },
          "prompt_en": {
            "type": "string"
          },
          "expected_answer_sv": {
            "type": "string"
          },
          "expected_answer_en": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "For gap_fill only: 4 word options"
          },
          "hint_en": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "prompt_sv",
          "expected_answer_sv"
        ]
      }
    }
  },
  "required": [
    "title_sv",
    "title_en",
    "level",
    "opener_sv"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}