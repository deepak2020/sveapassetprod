{
  "name": "Verb",
  "type": "object",
  "properties": {
    "infinitive": {
      "type": "string",
      "description": "Infinitiv (arbeta)"
    },
    "present": {
      "type": "string",
      "description": "Presens (arbetar)"
    },
    "past": {
      "type": "string",
      "description": "Preteritum (arbetade)"
    },
    "supine": {
      "type": "string",
      "description": "Supinum (arbetat). Empty for skola and m\u00e5ste"
    },
    "english": {
      "type": "string",
      "description": "English translation"
    },
    "group": {
      "type": "string",
      "enum": [
        "1",
        "2",
        "3",
        "4",
        "modal",
        "reflexive",
        "particle"
      ],
      "description": "Verb group: 1 (-ar), 2 (-er), 3 (korta verb), 4 (oregelbundna), modal, reflexive, particle"
    },
    "example_sentence": {
      "type": "string",
      "description": "Swedish example sentence"
    },
    "present_sentence": {
      "type": "string",
      "description": "Example sentence using presens, must contain the presens form (Jag arbetar hemma.)"
    },
    "past_sentence": {
      "type": "string",
      "description": "Example sentence using preteritum, must contain the preteritum form (Ig\u00e5r arbetade jag hemma.)"
    },
    "supine_sentence": {
      "type": "string",
      "description": "Example sentence using supinum, must contain the supinum form (Jag har arbetat hemma.)"
    },
    "level": {
      "type": "string",
      "default": "C"
    }
  },
  "required": [
    "infinitive",
    "present",
    "past",
    "english",
    "group"
  ],
